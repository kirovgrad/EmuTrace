{
  "name": "emutrace",
  "private": true,
  "version": "2.0.0",
  "description": "Local Unicorn execution trace inspector",
  "scripts": {
    "test": "node --test tests/core.test.cjs",
    "test:ui": "node tests/viewer.test.cjs",
    "format": "prettier --write emu_viewer.css emu_viewer.html emu_viewer.js emu_core.js \"tests/*.cjs\"",
    "format:check": "prettier --check emu_viewer.css emu_viewer.html emu_viewer.js emu_core.js \"tests/*.cjs\""
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "prettier": "3.6.2"
  }
}
